# rootyhospitality.com — biến môi trường. CHỈ có tên biến + giải thích; giá trị thật đặt trong .env (máy dev) hoặc Render (production).
# Ghi giá trị trong ngoặc kép "...". Có ký tự $ thì viết \$.

# ── Nguồn dữ liệu ─────────────────────────────────────────────────────────────
# "db" = Postgres của Rooty (giá theo ngày, tồn web, đặt phòng thật, admin sửa sản phẩm).
# Bỏ trống / "gohost" = như bản cũ: giá + phòng trống GET Gohost, nội dung đọc src/content, đặt phòng là bản minh hoạ.
DATA_SOURCE=

# ── Postgres (docs/db-setup.md) ───────────────────────────────────────────────
# postgresql://hospitality_app:<mật khẩu>@<host>:5432/hospitality?sslmode=require
# Database dùng chung với dự án khác → thêm &schema=<tên schema> (vd prod: crm_pl30 + schema=hospitality). Bỏ trống = public.
DATABASE_URL=

# ── Đăng nhập (Auth.js) — khách đặt phòng + admin ─────────────────────────────
# Chuỗi ngẫu nhiên ≥ 32 ký tự (vd: openssl rand -base64 32). Đổi = mọi phiên đăng nhập hết hiệu lực.
AUTH_SECRET=
# Production: URL gốc của site (https://rootyhospitality.com). Máy dev bỏ trống.
AUTH_URL=
# Google OAuth (tuỳ chọn — không có thì chỉ đăng nhập bằng email + mã).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google  (máy dev: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email (Nodemailer qua SMTP, mặc định Gmail) — mã đăng nhập, xác nhận đặt phòng, báo khách sạn ──
# Gmail: bật xác minh 2 bước → myaccount.google.com/apppasswords → tạo "mật khẩu ứng dụng" 16 ký tự → dán vào SMTP_PASS.
# Thiếu SMTP_USER/SMTP_PASS: máy dev in email + mã ra console; production BẮT BUỘC có (không thì khách không nhận được mã).
SMTP_USER=
SMTP_PASS=
# Tuỳ chọn — mặc định smtp.gmail.com:465. Đổi khi dùng SMTP khác (Google Workspace vẫn là smtp.gmail.com).
SMTP_HOST=
SMTP_PORT=
# Tuỳ chọn — tên hiển thị người gửi, vd: Rooty Hospitality <ten@gmail.com>. Gmail luôn gửi bằng địa chỉ SMTP_USER.
EMAIL_FROM=

# ── Thanh toán ────────────────────────────────────────────────────────────────
# "mock" = cổng giả lập (/thanh-toan-gia-lap) cho cả hai hình thức khách chọn (chuyển khoản ngân hàng, OnePay). Chưa tích hợp cổng thật.
PAYMENT_PROVIDER=
# Khoá ký webhook của cổng giả lập (bỏ trống thì dùng AUTH_SECRET).
PAYMENT_MOCK_SECRET=

# ── Cron hết hạn giữ phòng ────────────────────────────────────────────────────
# POST /api/cron/expire-holds với header Authorization: Bearer <CRON_SECRET>, mỗi 1–5 phút.
CRON_SECRET=

# ── Ảnh admin tải lên ─────────────────────────────────────────────────────────
# Thư mục ghi được, KHÔNG mất khi deploy (Render Persistent Disk, vd /var/data/uploads). Bỏ trống = tắt tải ảnh.
UPLOAD_DIR=

# ── Admin dự phòng (luôn là ADMIN) ────────────────────────────────────────────
# Tên không có dấu ":". Mật khẩu cũng là khoá ký cookie phiên admin.
ADMIN_USER=
ADMIN_PASSWORD=

# ── Gohost PMS Public API (tuỳ chọn khi DATA_SOURCE=db) ───────────────────────
# Scope chỉ đọc: properties:read + bookings:read. Dùng cho: tab Ánh xạ / Giá Gohost, Booking Gohost, yarn db:import-gohost.
GOHOST_API_KEY=
GOHOST_API_SECRET=
